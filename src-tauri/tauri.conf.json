{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Astrologiprogrammet",
  "version": "../package.json",
  "identifier": "dk.morsastro.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Astrologiprogrammet",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": {
      "../resources/ephe": "ephe",
      "../resources/places.tsv": "places.tsv"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5ODVDRkM1RDNBNUEzODgKUldTSW82WFR4YytGK1JPUzZGTHdaQ0tBTDZVc0J0aTk5QVQ5eTBkQnJ0YVJodG84RzNuVUtNcEkK",
      "endpoints": [
        "https://github.com/CurryDK/astrologiprogrammet/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
